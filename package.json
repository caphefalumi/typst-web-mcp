{
  "name": "typst-mcp",
  "version": "1.3.0",
  "description": "Model Context Protocol (MCP) server for https://typst.app/ cloud projects, Yjs real-time text editing, asset management, and Typst compiler diagnostics",
  "keywords": [
    "mcp",
    "typst",
    "typst.app",
    "yjs",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/caphefalumi/typst-web-mcp#readme",
  "bugs": {
    "url": "https://github.com/caphefalumi/typst-web-mcp/issues"
  },
  "license": "MIT",
  "author": {
    "name": "caphefalumi",
    "email": "dangduytoan13l@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caphefalumi/typst-web-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "typst-mcp": "dist/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:smoke": "bun test test/smoke.test.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "diff": "^9.0.0",
    "lib0": "^0.2.99",
    "yjs": "^13.6.24",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/node": "^25.0.3",
    "typescript": "^5.8.2"
  }
}
